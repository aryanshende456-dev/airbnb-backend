<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>airbnb home</title>
    <link href="./output.css" rel="stylesheet">
    <link href="home.css" rel="stylesheet">
</head>
<body class="bg-gray-100 min-h-screen">
<%- include('partials/nav')%>
  <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-6xl text-left">
    <h2 class="text-3xl md:text-5xl text-gray-800 font-bold text-center mb-2">
      Here are the registered homes
    </h2>
    <p class="text-lg text-red-700 text-center mb-8">
      Browse every home hosts have added so far.
    </p>

    <% if (registeredHomes.length === 0) { %>
      <div class="text-center rounded-lg border border-dashed border-red-500/30 bg-gray-100 p-8">
        <p class="text-lg text-gray-800 mb-4">No homes registered yet.</p>
        <a href="/host/add-home"
          class="inline-block bg-red-500 text-white font-bold py-2 px-4 rounded transition duration-300 hover:bg-red-400">
          Add your first home
        </a>
      </div>
    <% } else { %>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% registeredHomes.forEach(home => { %>
          <% const photoUrl = (home.photoUrl || '').trim(); %>
          <% const fallbackPhoto = 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=800&auto=format&fit=crop'; %>
          <% const displayPrice = String(home.price || '').trim().replace(/^\$/, ''); %>
          <li
            class="overflow-hidden rounded-lg border border-gray-100 bg-white shadow-md transition duration-300 hover:shadow-lg">
            <img
              src="<%= photoUrl || fallbackPhoto %>"
              alt="<%= home.houseName %>"
              referrerpolicy="no-referrer"
              onerror="this.onerror=null;this.src='<%= fallbackPhoto %>';"
              class="h-48 w-full object-cover bg-gray-100"
            />
            <div class="p-4 space-y-2">
              <div class="flex items-start justify-between gap-2">
                <h3 class="text-lg font-bold text-gray-800 leading-tight">
                  <%= home.houseName %>
                </h3>
                <% if (home.rating) { %>
                  <span class="flex shrink-0 items-center gap-1 text-sm font-bold text-gray-800">
                    ★ <%= home.rating %>
                  </span>
                <% } %>
              </div>
              <% if (home.location) { %>
                <p class="text-sm text-red-700">
                  <%= home.location %>
                </p>
              <% } %>
              <% if (displayPrice) { %>
                <p class="text-lg font-bold text-gray-800">
                  <span class="text-red-500">$</span><%= displayPrice %>
                  <span class="text-sm font-normal text-gray-800/70"> / night</span>
                </p>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </main>

</body>
</html>